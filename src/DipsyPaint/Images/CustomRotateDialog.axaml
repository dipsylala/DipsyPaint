<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:DipsyPaint.Resources"
        x:Class="DipsyPaint.Images.CustomRotateDialog"
        Title="{x:Static res:TransformStrings.CustomRotateDialogTitle}"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12" MinWidth="280">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Label Content="{x:Static res:TransformStrings.Angle}" Target="AngleBox" VerticalAlignment="Center" />
      <NumericUpDown x:Name="AngleBox" Grid.Column="1" Minimum="-360" Maximum="360" Increment="1" Value="0"
                     FormatString="0" ParsingNumberStyle="Integer"
                     AutomationProperties.Name="{x:Static res:TransformStrings.Angle}" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" IsDefault="True" MinWidth="80" Click="OnOkClick"
              Content="{x:Static res:ImageStrings.Ok}"
              AutomationProperties.Name="{x:Static res:ImageStrings.Ok}" />
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="80" Click="OnCancelClick"
              Content="{x:Static res:ImageStrings.Cancel}"
              AutomationProperties.Name="{x:Static res:ImageStrings.Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
