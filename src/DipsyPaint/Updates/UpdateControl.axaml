<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:DipsyPaint.Resources"
             x:Class="DipsyPaint.Updates.UpdateControl"
             IsVisible="False">
  <Button x:Name="RestartButton" Click="OnRestartClick" VerticalAlignment="Center" Margin="8,0"
          Content="{x:Static res:UpdateStrings.RestartToUpdate}"
          AutomationProperties.Name="{x:Static res:UpdateStrings.RestartToUpdate}"
          ToolTip.Tip="{x:Static res:UpdateStrings.RestartToUpdateToolTip}" />
</UserControl>
