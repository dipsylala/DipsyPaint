<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:DipsyPaint.Resources"
             xmlns:layout="using:DipsyPaint.Layout"
             x:Class="DipsyPaint.Tools.StrokeSizeOptions">
  <!-- Wraps, so size and opacity fit a narrow window; the code-behind appends the opacity options. -->
  <WrapPanel x:Name="Items" Orientation="{Binding $self.(layout:CommandGroup.Orientation)}" ItemSpacing="8" LineSpacing="4">
    <StackPanel Orientation="{Binding $self.(layout:CommandGroup.Orientation)}" Spacing="8">
      <TextBlock Text="{x:Static res:BrushStrings.Size}" VerticalAlignment="Center" />
      <Slider x:Name="SizeSlider" Width="140" Height="40" VerticalAlignment="Center"
              SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
              AutomationProperties.Name="{x:Static res:BrushStrings.Size}"
              ToolTip.Tip="{x:Static res:BrushStrings.SizeToolTip}" />
      <TextBlock x:Name="SizeText" MinWidth="48" VerticalAlignment="Center" />
    </StackPanel>
  </WrapPanel>
</UserControl>
