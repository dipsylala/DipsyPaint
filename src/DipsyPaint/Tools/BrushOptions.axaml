<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:DipsyPaint.Resources"
             xmlns:layout="using:DipsyPaint.Layout"
             x:Class="DipsyPaint.Tools.BrushOptions">
  <!-- The brush menu, then the size and opacity options; the code-behind appends those. -->
  <WrapPanel x:Name="Items" Orientation="{Binding $self.(layout:CommandGroup.Orientation)}" ItemSpacing="8" LineSpacing="4">
    <ComboBox x:Name="BrushBox" Width="180" Height="32" VerticalAlignment="Center"
              AutomationProperties.Name="{x:Static res:BrushStrings.Brushes}"
              ToolTip.Tip="{x:Static res:BrushStrings.Brushes}" />
  </WrapPanel>
</UserControl>
