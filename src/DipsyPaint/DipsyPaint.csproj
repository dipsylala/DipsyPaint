<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\dipsypaint.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- One .resx per feature; each generates a class named after its file. -->
    <EmbeddedResource Update="Resources\*.resx"
                      StronglyTypedLanguage="C#"
                      StronglyTypedNamespace="DipsyPaint.Resources"
                      StronglyTypedClassName="%(Filename)"
                      StronglyTypedFileName="$(IntermediateOutputPath)%(Filename).Designer.cs"
                      PublicClass="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DipsyPaint.Engine\DipsyPaint.Engine.csproj" />
  </ItemGroup>
</Project>
