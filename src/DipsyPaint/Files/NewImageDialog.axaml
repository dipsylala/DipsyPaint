<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:DipsyPaint.Resources"
        x:Class="DipsyPaint.Files.NewImageDialog"
        Title="{x:Static res:FileStrings.NewImageDialogTitle}"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16" MinWidth="320">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
      <Label Content="{x:Static res:NewImageStrings.Size}" Target="SizeBox" VerticalAlignment="Center" />
      <ComboBox x:Name="SizeBox" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" MinWidth="300"
                MaxDropDownHeight="480" SelectionChanged="OnSizeSelectionChanged"
                AutomationProperties.Name="{x:Static res:NewImageStrings.Size}" />
      <Label Grid.Row="1" Content="{x:Static res:FileStrings.Width}" Target="WidthBox" VerticalAlignment="Center" />
      <NumericUpDown x:Name="WidthBox" Grid.Row="1" Grid.Column="1" Minimum="1" Increment="1"
                     FormatString="0" ParsingNumberStyle="Integer" ValueChanged="OnSideChanged"
                     AutomationProperties.Name="{x:Static res:FileStrings.Width}" />
      <Label Grid.Row="2" Content="{x:Static res:FileStrings.Height}" Target="HeightBox" VerticalAlignment="Center" />
      <NumericUpDown x:Name="HeightBox" Grid.Row="2" Grid.Column="1" Minimum="1" Increment="1"
                     FormatString="0" ParsingNumberStyle="Integer" ValueChanged="OnSideChanged"
                     AutomationProperties.Name="{x:Static res:FileStrings.Height}" />
      <Button x:Name="SwapButton" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center"
              Width="40" Height="40" Click="OnSwapClick"
              AutomationProperties.Name="{x:Static res:NewImageStrings.SwapSides}"
              ToolTip.Tip="{x:Static res:NewImageStrings.SwapSides}">
        <!-- ⇄: right arrow above left arrow. -->
        <PathIcon Width="16" Height="16"
                  Data="M1,4 H11 V1 L15,5 L11,9 V6 H1 Z M15,10 H5 V7 L1,11 L5,15 V12 H15 Z" />
      </Button>
      <!-- Read-only for now (ADR-0024); its own row so the value can become an editable dropdown. -->
      <Label Grid.Row="3" Content="{x:Static res:NewImageStrings.Resolution}" VerticalAlignment="Center" />
      <TextBlock x:Name="ResolutionValue" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="OkButton" IsDefault="True" MinWidth="80" Click="OnOkClick"
              Content="{x:Static res:FileStrings.Ok}"
              AutomationProperties.Name="{x:Static res:FileStrings.Ok}" />
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="80" Click="OnCancelClick"
              Content="{x:Static res:FileStrings.Cancel}"
              AutomationProperties.Name="{x:Static res:FileStrings.Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
