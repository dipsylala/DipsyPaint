<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:DipsyPaint.Resources"
        xmlns:local="using:DipsyPaint"
        x:Class="DipsyPaint.MainWindow"
        Title="{x:Static res:Strings.AppName}"
        Icon="avares://DipsyPaint/Assets/dipsypaint.ico"
        Width="1100" Height="750">
  <DockPanel>
    <Border x:Name="CommandBar" DockPanel.Dock="Top" MinHeight="48"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="12,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <local:ZoomControl x:Name="Zoom" DockPanel.Dock="Right" Target="{Binding #CanvasZoom}" />
        <TextBlock x:Name="CanvasSizeText" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <!-- Zoom scales this wrapper, not the canvas; nearest-neighbour keeps zoomed pixels crisp. -->
      <LayoutTransformControl x:Name="CanvasZoom" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                              RenderOptions.BitmapInterpolationMode="None">
        <Border x:Name="Canvas" Background="White"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                AutomationProperties.Name="{x:Static res:Strings.CanvasAutomationName}" />
      </LayoutTransformControl>
    </ScrollViewer>
  </DockPanel>
</Window>
