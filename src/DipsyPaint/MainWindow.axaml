<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:DipsyPaint.Resources"
        xmlns:local="using:DipsyPaint"
        xmlns:drawing="using:DipsyPaint.Drawing"
        xmlns:tools="using:DipsyPaint.Tools"
        xmlns:files="using:DipsyPaint.Files"
        xmlns:diagnostics="using:DipsyPaint.Diagnostics"
        xmlns:images="using:DipsyPaint.Images"
        xmlns:updates="using:DipsyPaint.Updates"
        xmlns:layout="using:DipsyPaint.Layout"
        xmlns:layers="using:DipsyPaint.Layers"
        xmlns:text="using:DipsyPaint.Text"
        xmlns:view="using:DipsyPaint.View"
        x:Class="DipsyPaint.MainWindow"
        Title="{x:Static res:Strings.AppName}"
        Icon="avares://DipsyPaint/Assets/dipsypaint.ico"
        Width="1100" Height="750" MinWidth="480" MinHeight="400">
  <DockPanel>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="12,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <local:ZoomControl x:Name="Zoom" DockPanel.Dock="Right" Target="{Binding #CanvasZoom}" />
        <TextBlock x:Name="CanvasSizeText" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <!-- The command bar: one wrapping panel per window edge (ADR-0022). A command group is registered
         with one line in the edge panel where it sits by default, with a stable layout:CommandGroup.Id;
         the order here is the default order. Users can then move groups to any edge. -->
    <Border x:Name="CommandBar" DockPanel.Dock="Top"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <WrapPanel x:Name="TopEdge">
        <files:FileMenu x:Name="FileMenu" layout:CommandGroup.Id="file" layout:CommandGroup.Title="{x:Static res:FileStrings.File}" />
        <view:ViewMenu x:Name="ViewMenu" layout:CommandGroup.Id="view" layout:CommandGroup.Title="{x:Static res:ViewStrings.View}" />
        <local:HistoryControl layout:CommandGroup.Id="history" layout:CommandGroup.Title="{x:Static res:LayoutStrings.HistoryGroupName}" />
        <local:ClipboardControl layout:CommandGroup.Id="clipboard" layout:CommandGroup.Title="{x:Static res:ClipboardStrings.Clipboard}" />
        <images:ImageControl x:Name="ImageGroup" layout:CommandGroup.Id="image" layout:CommandGroup.Title="{x:Static res:ImageStrings.ImageGroupName}" />
        <tools:ToolPicker layout:CommandGroup.Id="tools" layout:CommandGroup.Title="{x:Static res:ToolStrings.ToolsGroupName}" />
        <local:ColourControl layout:CommandGroup.Id="colours" layout:CommandGroup.Title="{x:Static res:ColourStrings.ColoursGroupName}" />
        <diagnostics:HelpMenu x:Name="HelpMenu" layout:CommandGroup.Id="help" layout:CommandGroup.Title="{x:Static res:ReportStrings.Help}" />
        <updates:UpdateControl x:Name="Updates" layout:CommandGroup.Id="update" layout:CommandGroup.Title="{x:Static res:LayoutStrings.UpdateGroupName}" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <WrapPanel x:Name="BottomEdge" />
    </Border>
    <Border DockPanel.Dock="Left" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <WrapPanel x:Name="LeftEdge" Orientation="Vertical" layout:CommandGroup.Orientation="Vertical" />
    </Border>
    <Border DockPanel.Dock="Right" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <WrapPanel x:Name="RightEdge" Orientation="Vertical" layout:CommandGroup.Orientation="Vertical">
        <layers:LayersPanel x:Name="Layers" layout:CommandGroup.Id="layers" layout:CommandGroup.Title="{x:Static res:LayerStrings.Layers}" />
      </WrapPanel>
    </Border>
    <view:CanvasRulers x:Name="Rulers" Canvas="{Binding #Canvas}">
    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <!-- Zoom scales this wrapper, not the canvas; nearest-neighbour keeps zoomed pixels crisp. -->
      <LayoutTransformControl x:Name="CanvasZoom" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False"
                              RenderOptions.BitmapInterpolationMode="None">
        <Border x:Name="Canvas" Background="White"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                AutomationProperties.Name="{x:Static res:Strings.CanvasAutomationName}">
          <Panel>
            <drawing:DocumentCanvas x:Name="DocumentView" />
            <view:Gridlines x:Name="Gridlines" />
            <text:TextEntry x:Name="TextEntry" />
          </Panel>
        </Border>
      </LayoutTransformControl>
    </ScrollViewer>
    </view:CanvasRulers>
  </DockPanel>
</Window>
