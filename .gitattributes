# Normalise text to LF in the repo and working tree on every OS
* text=auto eol=lf

# Binary assets (golden images, test corpora, icons, project files)
*.png  binary
*.jpg  binary
*.jpeg binary
*.jpe  binary
*.jfif binary
*.bmp  binary
*.dib  binary
*.gif  binary
*.tif  binary
*.tiff binary
*.ico  binary
*.webp binary
*.ora  binary
*.zip  binary
